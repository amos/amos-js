{
  "name": "@amos.com/amos-js",
  "version": "0.11.33",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amos/amos-js.git"
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "biome": "biome check --write",
    "dev": "vite",
    "prebuild": "npm run typecheck",
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "author": "Amos",
  "license": "MIT",
  "browserslist": [
    "chrome >= 64",
    "firefox >= 67",
    "safari >= 12",
    "ios >= 12",
    "samsung >= 9",
    "edge >= 79",
    "opera >= 51"
  ],
  "description": "Amos JavaScript SDK for embedding payment methods via iframes.",
  "devDependencies": {
    "@amos.com/node": "0.1.65",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.2",
    "@typescript/typescript6": "6.0.2",
    "@vitest/browser-playwright": "5.0.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.1",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@types/googlepay": "0.7.13"
  },
  "peerDependencies": {
    "@amos.com/node": ">=0.1.65"
  }
}
